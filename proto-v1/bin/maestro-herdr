#!/bin/sh
set -eu

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if command -v herdr >/dev/null 2>&1; then
  exec herdr "$@"
fi
if [ -x /opt/homebrew/bin/herdr ]; then
  exec /opt/homebrew/bin/herdr "$@"
fi
if [ -x /usr/local/bin/herdr ]; then
  exec /usr/local/bin/herdr "$@"
fi

printf 'Maestro requires Herdr. Run the Maestro installer first.\n' >&2
exit 127
