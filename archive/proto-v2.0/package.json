{
  "name": "maestro-v2",
  "productName": "Maestro",
  "version": "2.0.0",
  "private": true,
  "description": "v2 Electron route: a macOS graphical orchestrator for Copilot Fleets.",
  "main": "out/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/main/index.cjs --external:electron --external:@github/copilot",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot": "1.0.80"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
