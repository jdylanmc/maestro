# Generated by Maestro. Re-run install.sh after changing this template.
[ui]
agent_panel_sort = "priority"
hide_tab_bar_when_single_tab = true
show_agent_labels_on_pane_borders = true

[ui.sidebar.agents.rows_by_agent]
copilot = [
  ["state_icon", "workspace", "tab"],
  ["agent"],
  [{ token = "$fleet_summary", fg = "#a7b1c4", bold = true, dim = false }],
  [{ token = "$fleet1", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet2", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet3", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet4", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet5", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet6", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet7", fg = "#a3be8c", dim = false }],
  [{ token = "$fleet8", fg = "#a3be8c", dim = false }],
]
claude = [["state_icon", "workspace", "tab"], ["agent"]]
codex = [["state_icon", "workspace", "tab"], ["agent"]]
gemini = [["state_icon", "workspace", "tab"], ["agent"]]
shell = [["state_icon", "workspace", "tab"], ["agent"]]

[terminal]
default_shell = "@MAESTRO_AGENT@"
shell_mode = "non_login"
new_cwd = "follow"

[theme]
name = "nord"
auto_switch = false

[theme.custom]
overlay0 = "#8f9cb3"
overlay1 = "#a7b1c4"
surface_dim = "#434c5e"

[ui.toast]
delivery = "system"
